<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog / menu sheet: dense dark glass, specular rim, floating with an inset -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <layer-list>
        <item>
            <shape>
                <gradient android:angle="270" android:startColor="@color/sheet_top" android:endColor="@color/sheet_bottom" />
                <corners android:radius="28dp" />
            </shape>
        </item>
        <item>
            <shape>
                <gradient android:angle="270" android:startColor="#1AFFFFFF" android:centerColor="#00FFFFFF"
                    android:centerY="0.3" android:endColor="#00FFFFFF" />
                <corners android:radius="28dp" />
            </shape>
        </item>
        <item>
            <shape>
                <stroke android:width="1dp" android:color="@color/glass_rim" />
                <corners android:radius="28dp" />
            </shape>
        </item>
    </layer-list>
</inset>
