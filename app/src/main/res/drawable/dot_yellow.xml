<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy colour-key bead (Liquid Glass): saturated body, specular highlight, light rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp" />
            <solid android:color="@color/key_yellow" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp" />
            <gradient android:type="radial" android:centerX="0.38" android:centerY="0.3"
                android:gradientRadius="7dp" android:startColor="#B3FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
