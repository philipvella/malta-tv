<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass glass_toast: translucent body with top sheen, specular rim, inner rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="@color/sheet_top" android:endColor="@color/sheet_bottom" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:centerColor="#00FFFFFF"
                android:centerY="0.45" android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/glass_rim" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape>
            <stroke android:width="1dp" android:color="@color/glass_rim_inner" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
