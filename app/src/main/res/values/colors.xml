<resources>
    <!-- Liquid Glass tokens. See .claude/skills/malta-tv-liquid-glass/SKILL.md before changing. -->

    <!-- Environment (what the glass floats over) -->
    <color name="bg">#FF07090D</color>
    <color name="ambient_red">#73C8102E</color>
    <color name="ambient_cool">#2E5A7BA8</color>
    <color name="malta_red">#FFC8102E</color>
    <color name="malta_red_deep">#FF6E0014</color>
    <color name="malta_red_lit">#FFE3173A</color>

    <!-- Clear glass (controls at rest) -->
    <color name="glass_top">#2EFFFFFF</color>
    <color name="glass_bottom">#0DFFFFFF</color>
    <color name="glass_rim">#4DFFFFFF</color>
    <color name="glass_rim_inner">#14FFFFFF</color>

    <!-- Focused glass (the remote's focus): brighter, white rim -->
    <color name="glass_focus_top">#80FFFFFF</color>
    <color name="glass_focus_bottom">#38FFFFFF</color>
    <color name="glass_focus_rim">#FFFFFFFF</color>

    <!-- Tinted glass (selected / active station): Malta red -->
    <color name="glass_red_top">#E6E8213F</color>
    <color name="glass_red_bottom">#CC9E0B24</color>

    <!-- Panels: bars, dialogs, toasts. Denser than clear glass because Android 9 has no live blur. -->
    <color name="panel_top">#B3242B36</color>
    <color name="panel_bottom">#A60D1117</color>
    <color name="sheet_top">#F21E242E</color>
    <color name="sheet_bottom">#F00B0E13</color>

    <!-- Text on glass -->
    <color name="text">#FFF8F9FB</color>
    <color name="text_dim">#B3FFFFFF</color>
    <color name="text_hint">#73FFFFFF</color>

    <!-- Colour keys on the remote -->
    <color name="key_red">#FFE53935</color>
    <color name="key_green">#FF43A047</color>
    <color name="key_yellow">#FFFDD835</color>
    <color name="key_blue">#FF1E88E5</color>

    <!-- kept for older references -->
    <color name="btn_active">@color/malta_red</color>
</resources>
