<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass layout. Rules: .claude/skills/malta-tv-liquid-glass/SKILL.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Floating glass control bar (hidden in full screen) -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/glass_bar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="18dp"
                android:adjustViewBounds="true"
                android:contentDescription="Malta TV"
                android:src="@drawable/splash_logo" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/stationList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Colour keys on the remote, in remote order: red, green, yellow, blue -->
            <Button android:id="@+id/btnRefresh" style="@style/GlassButton"
                android:drawableStart="@drawable/dot_red" android:text="Refresh" />
            <Button android:id="@+id/btnFullscreen" style="@style/GlassButton"
                android:drawableStart="@drawable/dot_green" android:text="Full screen" />
            <Button android:id="@+id/btnAdd" style="@style/GlassButton"
                android:drawableStart="@drawable/dot_yellow" android:text="Add station" />
            <Button android:id="@+id/btnSettings" style="@style/GlassButton"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:drawableStart="@drawable/dot_blue" android:drawableEnd="@drawable/ic_settings"
                android:drawablePadding="4dp" android:contentDescription="Settings" />
            <ImageButton android:id="@+id/btnExit" style="@style/GlassIconButton" android:layout_marginEnd="0dp"
                android:src="@drawable/ic_power" android:contentDescription="Exit" />
        </LinearLayout>

        <!-- Glass address pill: the web page being loaded -->
        <LinearLayout
            android:id="@+id/urlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/urlText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="160dp"
                android:layout_height="4dp"
                android:max="100"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/text" />
        </LinearLayout>

        <!-- The web page, framed in glass with rounded corners -->
        <FrameLayout
            android:id="@+id/webFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/glass_frame"
            android:padding="1dp">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- Holder for HTML5 video fullscreen (WebChromeClient custom view) -->
    <FrameLayout
        android:id="@+id/videoFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

    <!-- Virtual mouse pointer for the TV remote (drawn above everything) -->
    <com.philipvella.maltatv.PointerOverlay
        android:id="@+id/pointer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Splash: Malta-red environment, glass card with the logo, developer credit -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash"
        android:clickable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/splashCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_card"
            android:elevation="0dp"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="44dp"
            android:paddingBottom="44dp">

            <ImageView
                android:layout_width="460dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Malta TV"
                android:src="@drawable/splash_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/glass_pill"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Developed by vellaphilip.com"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </FrameLayout>
</FrameLayout>
